  createdAt    DateTime            @default(now())
  project      NovelProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromEvent    NovelNarrativeEvent @relation("NovelCausalFrom", fields: [fromEventId], references: [id], onDelete: Cascade)
  toEvent      NovelNarrativeEvent @relation("NovelCausalTo", fields: [toEventId], references: [id], onDelete: Cascade)

  @@unique([projectId, fromEventId, toEventId, relationType])
}

model NovelNarrativeDebt {
  id                 String               @id @default(cuid())
  projectId          String
  debtType           String
  title              String
