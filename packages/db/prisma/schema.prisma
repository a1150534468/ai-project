generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                       @id @default(cuid())
  uid                         String                       @unique
  username                    String                       @unique
  passwordHash                String
  bannedAt                    DateTime?
  memoryEnabled               Boolean                      @default(true)
  createdAt                   DateTime                     @default(now())
  sessions                    Session[]
  agents                      UserAgent[]
  imageAssets                 ImageAsset[]
  imageGenerationTasks        ImageGenerationTask[]
  videoAssets                 VideoAsset[]
  audioAssets                 AudioAsset[]
  articleWorkflowProjects     ArticleWorkflowProject[]
  novelProjects               NovelProject[]
  novelTasks                  NovelTask[]
  novelRuns                   NovelRun[]
  avatars                     Avatar[]
  codexPetProjects            CodexPetProject[]
  codexPetRuns                CodexPetRun[]
  codexPetJobs                CodexPetJob[]
  codexPetArtifacts           CodexPetArtifact[]
  codexPetEvents              CodexPetEvent[]
  codexPetImageCalls          CodexPetImageCall[]

}

model Session {
  id              String    @id @default(cuid())
  userId          String
  title           String    @default("新对话")
  agentId         String?
  agentName       String?
  agentPrompt     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        Message[]
  attachedKbIds   String[]  @default([])
  kbAttachAllOwn  Boolean   @default(false)
  attachedToolIds String[]  @default([])

  @@index([userId])
  @@index([userId, agentId])
}

model UserAgent {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  prompt      String
  modelUsed   String?
  avatarSvg   String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  model     String?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Memory {
  id         String                      @id @default(cuid())
  userId     String
  title      String                      @default("")
  text       String
  type       String                      @default("OTHER")
  importance Int                         @default(50)
  tags       Json                        @default("[]")
  embedding  Unsupported("vector(1024)")
  metadata   Json?
  lastUsedAt DateTime?
  usedCount  Int                         @default(0)
  createdAt  DateTime                    @default(now())

  @@index([userId])
  @@index([userId, type])
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String // super_admin | admin
  permissions  String[] @default([])
  disabled     Boolean  @default(false)
  createdBy    String?
  createdAt    DateTime @default(now())
}

model AdminAudit {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  target    String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  active    Boolean   @default(true)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
}

model KnowledgeBase {
  id          String     @id @default(cuid())
  ownerType   String // "USER" | "OFFICIAL"
  userId      String?
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]

  @@index([userId])
  @@index([ownerType])
}

model Document {
  id           String        @id @default(cuid())
  kbId         String
  name         String
  sourceType   String // "FILE" | "URL" | "TEXT"（ARTIFACT 随 P1.2/P5.2 退役：产物不再进知识库）
  sourceUri    String?
  mime         String?
  sizeBytes    Int?
  status       String        @default("pending") // pending|indexing|indexed|failed
  error        String?
  chunkCount   Int           @default(0)
  tokensUsed   Int           @default(0)
  opId         String?
  lockedBy     String?
  lockedAt     DateTime?
  attempts     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  kb           KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  chunks       Chunk[]

  @@index([kbId])
  @@index([status])
}

model CodexPetProject {
  id                   String             @id @default(cuid())
  userId               String
  name                 String
  description          String             @default("")
  prompt               String             @default("")
  actionPrompts        Json               @default("{}")
  stylePreset          String             @default("auto")
  styleNotes           String             @default("")
  referenceAssetIds    String[]           @default([])
  autoContinue         Boolean            @default(false)
  imageModel           String             @default("gpt-image-2")
  visualQaModel        String             @default("gpt-5.6-sol")
  qualityInspectionEnabled Boolean         @default(false)
  status               String             @default("draft")
  latestRunId          String?
  createIdempotencyKey String?
  deletedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs                 CodexPetRun[]
  jobs                 CodexPetJob[]
  artifacts            CodexPetArtifact[]
  events               CodexPetEvent[]
  imageCalls           CodexPetImageCall[]

  @@unique([userId, createIdempotencyKey])
  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([userId, deletedAt, updatedAt])
}

model CodexPetRun {
  id                            String             @id @default(cuid())
  projectId                     String
  userId                        String
  idempotencyKey                String?
  inputSnapshot                 Json               @default("{}")
  status                        String             @default("queued")
  progressStage                 String             @default("queued")
  progressPercent               Int                @default(0)
  progressMessage               String?
  autoContinue                  Boolean            @default(false)
  colorKey                      String?
  billingOperationId            String?            @unique
  billingMode                   String             @default("legacy_package_v1")
  billingResourceKey            String?
  billingReservedUnits          Int                @default(0)
  billingSettledUnits           Int                @default(0)
  billingReservedPoints         Int                @default(0)
  billingSettledPoints          Int                @default(0)
  billingSettlementStatus       String             @default("none")
  billingSettledAt              DateTime?
  billingPoints                 Int                @default(0)
  billingChargeStatus           String             @default("pending")
  billingChargeAttemptCount     Int                @default(0)
  billingChargeError            String?
  billingChargeLastAttemptAt    DateTime?
  billingChargeNextRetryAt      DateTime?
  billingChargeLeaseUntil       DateTime?
  billingChargedAt              DateTime?
  billingActivatedAt            DateTime?
  billingRefundedAt             DateTime?
  billingRefundStatus           String             @default("none")
  billingRefundError            String?
  billingRefundRetryCount       Int                @default(0)
  billingRefundLastAttemptAt    DateTime?
  billingRefundNextRetryAt      DateTime?
  cancelRequested               Boolean            @default(false)
  hasSuccessfulImage            Boolean            @default(false)
  selectedBaseArtifactId        String?
  spritesheetArtifactId         String?
  packageArtifactId             String?
  previewArtifactId             String?
  validationReport              Json?
  requestedModel                String             @default("gpt-image-2")
  visualQaModel                 String             @default("gpt-5.6-sol")
  qualityInspectionEnabled      Boolean            @default(true)
  imageGenerationCallCount      Int                @default(0)
  plannedImageCallLimit         Int                @default(0)
  imageGenerationApprovalBudget Int                @default(0)
  pendingImageJobKey            String?
  actualModels                  String[]           @default([])
  usage                         Json?
  lastEventSequence             Int                @default(0)
  workerId                      String?
  heartbeatAt                   DateTime?
  startedAt                     DateTime?
  completedAt                   DateTime?
  error                         String?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  project                       CodexPetProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs                          CodexPetJob[]
  artifacts                     CodexPetArtifact[]
  events                        CodexPetEvent[]
  imageCalls                    CodexPetImageCall[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt])
  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@index([billingChargeStatus, billingChargeNextRetryAt])
  @@index([billingRefundStatus, billingRefundNextRetryAt])
  @@index([billingMode, billingSettlementStatus])
}

model CodexPetImageCall {
  id                String          @id @default(cuid())
  projectId         String
  runId             String
  userId            String
  jobKey            String
  logicalAttempt    Int
  callKind          String          @default("planned")
  purpose           String
  requestedModel    String
  actualModel       String?
  operationId       String          @unique
  status            String          @default("prepared")
  resourceKey       String?
  units             Int             @default(1)
  points            Int             @default(0)
  upstreamRequestId String?
  sentAt            DateTime?
  completedAt       DateTime?
  error             String?
  refundStatus      String          @default("none")
  refundedAt        DateTime?
  refundError       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  project           CodexPetProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run               CodexPetRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, jobKey, logicalAttempt])
  @@index([projectId, createdAt])
  @@index([runId, status, createdAt])
  @@index([userId, createdAt])
}

model CodexPetJob {
  id                String             @id @default(cuid())
  projectId         String
  runId             String
  userId            String
  key               String
  kind              String
  status            String             @default("queued")
  dependencyKeys    String[]           @default([])
  attempt           Int                @default(0)
  maxAttempts       Int                @default(3)
  input             Json               @default("{}")
  output            Json?
  providerMetadata  Json?
  inputArtifactIds  String[]           @default([])
  outputArtifactIds String[]           @default([])
  error             String?
  workerId          String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  project           CodexPetProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run               CodexPetRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifacts         CodexPetArtifact[]

  @@unique([runId, key])
  @@index([projectId, createdAt])
  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model CodexPetArtifact {
  id        String          @id @default(cuid())
  projectId String
  runId     String
  userId    String
  jobId     String?
  kind      String
  name      String          @default("")
  status    String          @default("ready")
  objectKey String          @unique
  mime      String
  sizeBytes Int
  width     Int?
  height    Int?
  checksum  String?
  metadata  Json            @default("{}")
  expiresAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  project   CodexPetProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run       CodexPetRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       CodexPetJob?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([runId, kind, createdAt])
  @@index([userId, createdAt])
  @@index([jobId])
  @@index([expiresAt])
}

model CodexPetEvent {
  id        String          @id @default(cuid())
  projectId String
  runId     String
  userId    String
  sequence  Int
  type      String
  stage     String
  jobKey    String?
  message   String?
  progress  Int             @default(0)
  payload   Json            @default("{}")
  createdAt DateTime        @default(now())
  project   CodexPetProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run       CodexPetRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([projectId, createdAt])
  @@index([runId, createdAt])
  @@index([userId, createdAt])
}

model Chunk {
  id         String                      @id @default(cuid())
  documentId String
  kbId       String
  ordinal    Int
  content    String
  embedding  Unsupported("vector(1024)")
  createdAt  DateTime                    @default(now())
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([kbId])
  @@index([documentId])
}

model ImageAsset {
  id                      String               @id @default(cuid())
  userId                  String
  requestId               String
  requestIndex            Int
  prompt                  String
  model                   String
  size                    String
  originalUrl             String
  thumbnailUrl            String
  objectKey               String?
  mime                    String               @default("image/png")
  // size 是"请求"的尺寸；这两列是上游"实际交付"的像素，用于按真实交付档位结算。
  // 历史数据与拿不到二进制的 url 直存场景为 null。
  width                   Int?
  height                  Int?
  createdAt               DateTime             @default(now())
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, requestIndex])
  @@index([userId, createdAt])
}

model ImageGenerationTask {
  id                String   @id @default(cuid())
  userId            String
  requestId         String   @unique
  prompt            String
  model             String
  size              String
  referenceAssetIds String[] @default([])
  sourceImageAssetId String?
  generationIntent   String   @default("new")
  count             Int
  status            String   @default("running")
  completedCount    Int      @default(0)
  error             String?
  billingMode          String  @default("charge")
  billingResourceKey   String?
  billingReservedUnits Int     @default(0)
  billingSettledUnits  Int?
  billingStatus        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model VideoAsset {
  id           String   @id @default(cuid())
  userId       String
  requestId    String
  requestIndex Int      @default(0)
  prompt       String
  model        String
  aspectRatio  String
  resolution   String
  durationSec  Int
  originalUrl  String
  objectKey    String?
  mime         String   @default("video/mp4")
  format       String   @default("mp4")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, requestIndex])
  @@index([userId, createdAt])
}

model AudioAsset {
  id                      String                      @id @default(cuid())
  userId                  String
  projectId               String?
  requestId               String?
  kind                    String
  source                  String
  provider                String?
  providerModel           String?
  originalUrl             String
  objectKey               String?
  mime                    String                      @default("audio/wav")
  format                  String                      @default("wav")
  durationSec             Int                         @default(0)
  textContent             String?
  metadata                Json?
  createdAt               DateTime                    @default(now())
  user                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([userId, kind, createdAt])
  @@index([requestId])
}

model ArticleWorkflowProject {
  id                String   @id @default(cuid())
  userId            String
  creationMode      String   @default("source")
  creationConfigJson Json    @default("{}")
  sourceFormat      String
  sourceText        String
  generationMode    String   @default("preserve-text")
  // 产物平台：wechat 出排版 HTML，xiaohongshu / douyin 出文案 + 竖版配图
  platform          String   @default("wechat")
  // 一次导入 = 同 batchId 的 N 行；存量行为 null，视为单平台独立批次
  batchId           String?
  // 公众号排版主题：auto = AI 自由发挥；themeColor 为空 = 用主题默认主色
  theme             String   @default("auto")
  themeColor        String?
  // 配图画廊布局模式：collage / grid / stack；caption 平台恒为 collage
  galleryMode       String   @default("collage")
  title             String   @default("")
  summary           String   @default("")
  bodyHtml          String   @default("")
  // 公众号正文的 Markdown 原文：确定性主题换肤的前端本地渲染输入；auto 主题为空串
  bodyMarkdown      String   @default("")
  // caption 平台的正文文案与话题标签；公众号项目保持空值
  captionText       String   @default("")
  tagsJson          Json     @default("[]")
  imageManifestJson Json     @default("[]")
  status            String   @default("draft")
  progressStage     String   @default("draft")
  progressPercent   Int      @default(0)
  progressMessage   String?
  error             String?
  // 文本 reserve 的 operationId：进程崩溃后 reaper 靠它退款，终态写入时清空
  billingOperationId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([userId, batchId])
}

model NovelProject {
  id                    String                    @id @default(cuid())
  userId                String
  title                 String
  genre                 String                    @default("")
  premise               String                    @default("")
  settings              Json                      @default("{}")
  generationPrefs       Json                      @default("{}")
  narrativeContract     Json                      @default("{}")
  targetChapters        Int                       @default(100)
  targetCharsPerChapter Int                       @default(3000)
  setupStage            Int                       @default(1)
  setupCompleted        Boolean                   @default(false)
  storyPhase            String                    @default("opening")
  autopilotStatus       String                    @default("idle")
  currentBranch         String                    @default("main")
  status                String                    @default("active")
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters              NovelChapter[]
  tasks                 NovelTask[]
  vectorMemories        NovelVectorMemory[]
  knowledgeFacts        NovelKnowledgeFact[]
  foreshadowItems       NovelForeshadowItem[]
  runs                  NovelRun[]
  runEvents             NovelRunEvent[]
  outboxCommands        NovelCommandOutbox[]
  structureNodes        NovelStructureNode[]
  characters            NovelCharacter[]
  characterRelations    NovelCharacterRelation[]
  locations             NovelLocation[]
  timelineEvents        NovelTimelineEvent[]
  storylines            NovelStoryline[]
  storylineMilestones   NovelStorylineMilestone[]
  props                 NovelProp[]
  propEvents            NovelPropEvent[]
  narrativeEvents       NovelNarrativeEvent[]
  causalEdges           NovelCausalEdge[]
  narrativeDebts        NovelNarrativeDebt[]
  entityStates          NovelEntityState[]
  qualityReports        NovelQualityReport[]
  checkpoints           NovelCheckpoint[]
  promptTemplates       NovelPromptTemplate[]
  generationRequests    NovelGenerationRequest[]
  foreshadowEvents      NovelForeshadowEvent[]
  bible                 NovelBible?
  worldDimensions       NovelWorldDimension[]
  styleNotes            NovelStyleNote[]

  @@index([userId, updatedAt])
}

model NovelBible {
  id              String                @id @default(cuid())
  projectId       String                @unique
  premiseLock     String                @default("")
  genreLock       String                @default("")
  worldPresetLock String                @default("")
  version         Int                   @default(1)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  project         NovelProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worldDimensions NovelWorldDimension[]
  styleNotes      NovelStyleNote[]
}

model NovelWorldDimension {
  id           String       @id @default(cuid())
  projectId    String
  bibleId      String
  dimensionKey String
  title        String
  summary      String       @default("")
  details      Json         @default("{}")
  position     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  project      NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bible        NovelBible   @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@unique([projectId, dimensionKey])
  @@index([bibleId, position])
}

model NovelStyleNote {
  id        String       @id @default(cuid())
  projectId String
  bibleId   String
  category  String
  title     String
  content   String
  position  Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  project   NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bible     NovelBible   @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@unique([projectId, category, title])
  @@index([bibleId, position])
}

model NovelVectorMemory {
  id          String                      @id @default(cuid())
  projectId   String
  sourceType  String
  sourceId    String
  sourceKind  String
  title       String                      @default("")
  content     String
  contentHash String
  embedding   Unsupported("vector(1024)")
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  project     NovelProject                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceType, sourceId])
  @@index([projectId, sourceKind])
  @@index([projectId, updatedAt])
}

model NovelChapter {
  id                 String                   @id @default(cuid())
  projectId          String
  volumeIndex        Int                      @default(1)
  chapterIndex       Int
  title              String                   @default("")
  summary            String                   @default("")
  outline            String                   @default("")
  generationHint     String                   @default("")
  executionPlan      Json?
  microBeats         Json                     @default("[]")
  content            String                   @default("")
  rawContent         String                   @default("")
  openThreads        Json                     @default("[]")
  contextSnapshot    Json?
  generationMeta     Json?
  consistencyJson    Json?
  status             String                   @default("draft")
  reviewStatus       String                   @default("pending")
  reviewNotes        String                   @default("")
  aiReview           String                   @default("")
  aiActionItems      Json                     @default("[]")
  modificationRate   Int                      @default(0)
  reviewedAt         DateTime?
  tensionScore       Float                    @default(0)
  plotTension        Float                    @default(0)
  emotionalTension   Float                    @default(0)
  pacingTension      Float                    @default(0)
  qualityScore       Float                    @default(0)
  billableChars      Int                      @default(0)
  lastTaskId         String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  project            NovelProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions           NovelChapterVersion[]
  qualityReports     NovelQualityReport[]
  generationRequests NovelGenerationRequest[]
  foreshadowEvents   NovelForeshadowEvent[]

  @@unique([projectId, chapterIndex])
  @@index([projectId, updatedAt])
  @@index([projectId, reviewStatus])
}

model NovelKnowledgeFact {
  id            String       @id @default(cuid())
  projectId     String
  chapterId     String?
  chapterIndex  Int?
  subject       String
  predicate     String
  object        String
  sourceExcerpt String       @default("")
  confidence    Float        @default(0.7)
  status        String       @default("confirmed")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  project       NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, chapterIndex, subject, predicate, object])
  @@index([projectId, status])
  @@index([projectId, updatedAt])
}

model NovelForeshadowItem {
  id                       String                 @id @default(cuid())
  projectId                String
  introducedInChapterId    String?
  introducedInChapterIndex Int?
  title                    String
  description              String                 @default("")
  expectedPayoffChapter    Int                    @default(0)
  status                   String                 @default("open")
  relatedCharacter         String                 @default("")
  source                   String                 @default("manual")
  sourceKey                String?
  lastMentionedChapter     Int?
  resolvedInChapterIndex   Int?
  resolutionEvidence       String                 @default("")
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  project                  NovelProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events                   NovelForeshadowEvent[]
  narrativeDebts           NovelNarrativeDebt[]

  @@unique([projectId, title])
  @@unique([projectId, sourceKey])
  @@index([projectId, status])
  @@index([projectId, expectedPayoffChapter])
}

model NovelChapterVersion {
  id            String       @id @default(cuid())
  chapterId     String
  title         String       @default("")
  content       String
  billableChars Int          @default(0)
  operationId   String?
  createdAt     DateTime     @default(now())
  chapter       NovelChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, createdAt])
}

model NovelTask {
  id                String                  @id @default(cuid())
  projectId         String
  userId            String
  kind              String
  targetKind        String
  targetId          String?
  status            String                  @default("queued")
  progressPercent   Int                     @default(0)
  progressStage     String                  @default("queued")
  progressMessage   String?
  progressPreview   String                  @default("")
  streamedChars     Int                     @default(0)
  requestPayload    Json?
  resultPayload     Json?
  operationId       String                  @unique
  error             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  completedAt       DateTime?
  cancelledAt       DateTime?
  project           NovelProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  outboxCommand     NovelCommandOutbox?
  generationRequest NovelGenerationRequest?

  @@index([userId, updatedAt])
  @@index([projectId, updatedAt])
  @@index([status, updatedAt])
}

model NovelGenerationRequest {
  id              String        @id @default(cuid())
  projectId       String
  chapterId       String?
  chapterIndex    Int?
  taskId          String        @unique
  runId           String?
  stepId          String?
  targetKind      String
  attempt         Int           @default(1)
  systemPrompt    String
  userPrompt      String
  model           String
  temperature     Float?
  maxTokens       Int
  templateId      String?
  templateVersion Int?
  requestHash     String
  status          String        @default("submitted")
  error           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  project         NovelProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter         NovelChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  task            NovelTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId, chapterIndex, createdAt])
  @@index([chapterId, createdAt])
  @@index([runId, createdAt])
}

model NovelRun {
  id                    String               @id @default(cuid())
  projectId             String
  userId                String
  mode                  String
  status                String               @default("queued")
  currentStep           String?
  currentChapter        Int?
  startChapter          Int                  @default(1)
  targetChapters        Int
  targetCharsPerChapter Int                  @default(3000)
  completedChapters     Int                  @default(0)
  autoReview            Boolean              @default(true)
  pauseRequested        Boolean              @default(false)
  cancelRequested       Boolean              @default(false)
  consecutiveFailures   Int                  @default(0)
  lastEventSequence     Int                  @default(0)
  error                 String?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  project               NovelProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps                 NovelRunStep[]
  events                NovelRunEvent[]
  outboxCommands        NovelCommandOutbox[]

  @@index([projectId, updatedAt])
  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model NovelRunStep {
  id                 String              @id @default(cuid())
  runId              String
  sequence           Int
  kind               String
  status             String              @default("queued")
  chapterNumber      Int?
  attempt            Int                 @default(0)
  maxAttempts        Int                 @default(3)
  priority           Int                 @default(5)
  progress           Int                 @default(0)
  input              Json                @default("{}")
  output             Json?
  error              String?
  workerId           String?
  billingOperationId String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  run                NovelRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  outboxCommand      NovelCommandOutbox?

  @@unique([runId, sequence])
  @@index([runId, status])
  @@index([status, updatedAt])
}

model NovelRunEvent {
  id            String       @id @default(cuid())
  runId         String
  projectId     String
  sequence      Int
  type          String
  stage         String
  step          String?
  chapterNumber Int?
  progress      Int          @default(0)
  payload       Json         @default("{}")
  createdAt     DateTime     @default(now())
  run           NovelRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  project       NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([projectId, createdAt])
  @@index([runId, createdAt])
}

model NovelCommandOutbox {
  id          String        @id @default(cuid())
  projectId   String
  runId       String?
  stepId      String?       @unique
  taskId      String?       @unique
  queueName   String        @default("novel-runs")
  jobName     String        @default("execute-step")
  payload     Json
  priority    Int           @default(5)
  status      String        @default("pending")
  attempts    Int           @default(0)
  availableAt DateTime      @default(now())
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     NovelProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run         NovelRun?     @relation(fields: [runId], references: [id], onDelete: Cascade)
  step        NovelRunStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)
  task        NovelTask?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([runId, createdAt])
}

model NovelStructureNode {
  id           String               @id @default(cuid())
  projectId    String
  parentId     String?
  nodeType     String
  title        String
  description  String               @default("")
  number       Int
  startChapter Int?
  endChapter   Int?
  outline      String               @default("")
  metadata     Json                 @default("{}")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  project      NovelProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       NovelStructureNode?  @relation("NovelStructureTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     NovelStructureNode[] @relation("NovelStructureTree")

  @@unique([projectId, nodeType, number, parentId])
  @@index([projectId, parentId, number])
}

model NovelCharacter {
  id                String                   @id @default(cuid())
  projectId         String
  name              String
  role              String                   @default("")
  gender            String                   @default("")
  age               String                   @default("")
  description       String                   @default("")
  appearance        String                   @default("")
  personality       String                   @default("")
  publicProfile     String                   @default("")
  coreBelief        String                   @default("")
  coreMotivation    String                   @default("")
  innerLack         String                   @default("")
  moralTaboos       Json                     @default("[]")
  voiceStyle        String                   @default("")
