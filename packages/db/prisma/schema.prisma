  showLastActive  Boolean @default(true)
}

model WechatBinding {
  id         String    @id @default(cuid())
  userId     String
  deviceId   String    @unique
  targetType String // "agent" | "team"
  targetId   String
  model      String    @default("MiniMax-M3") // 微信回复用模型；多模态不支持时退避到 M3
  sessionId  String // 微信持续会话线程（指向 Session.id）
  online     Boolean   @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

model ReportTask {
  id           String   @id @default(cuid())
  userId       String
  stage        String   @default("pending")
  sourceType   String
  sourceName   String?
  intent       String?
  model        String
  htmlKey      String?
  truncated    Boolean  @default(false)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  rounds       Int      @default(0)
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt])
}

model Avatar {
  id              String   @id @default(cuid())
  userId          String
  avatarCode      String
  title           String   @default("未命名")
  coverUrl        String?
  sourceObjectKey String?
  isFavorite      Boolean  @default(false)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SkyhumanTask {
  id             String    @id @default(cuid())
  userId         String
  kind           String
  avatarId       String?
  projectId      String?
  providerTaskId String?
  status         String    @default("running")
  resourceKey    String
  operationId    String    @unique
  chargedPoints  Int       @default(0)
  audioObjectKey String?
  title          String    @default("未命名")
  resultPayload  Json?
  error          String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@index([providerTaskId])
  @@index([projectId])
  @@index([userId, createdAt])
}

model DubProject {
  id               String   @id @default(cuid())
  userId           String
  title            String   @default("未命名口播")
  sourceVideoUrl   String?
  analysis         Json?
  script           String?
  attachedKbIds    String[] @default([])
  ttsMode          String?
  audioUrl         String?
  audioObjectKey   String?
  audioDurationSec Int      @default(0)
  avatarId         String?
  bgmPresetId      String?
  bgmObjectKey     String?
  bgmVolume        Float    @default(0.3)
  resultVideoUrl   String?
  resultObjectKey  String?
  finalVideoUrl    String?
  finalObjectKey   String?
  stage            String   @default("draft")
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, stage])
}

model DubBgmPreset {
  id        String   @id @default(cuid())
  title     String
  url       String
  objectKey String
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([enabled, sortOrder])
}

model ScheduledTask {
  id        String             @id @default(cuid())
  userId    String
  title     String
  prompt    String             @db.Text
  agentId   String?
  model     String
  kbIds     Json?
  deviceId  String?
  cron      String
  timezone  String             @default("Asia/Shanghai")
  oneShot   Boolean            @default(false)
  enabled   Boolean            @default(true)
  emailTo   String
  nextRunAt DateTime
  lastRunAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs      ScheduledTaskRun[]

  @@index([userId])
  @@index([enabled, nextRunAt])
}

model ScheduledTaskRun {
  id            String        @id @default(cuid())
  taskId        String
  userId        String
  status        String // running | success | failed | skipped
  skipReason    String? // device_offline | insufficient_balance | billing_unavailable | prev_running
  triggeredAt   DateTime
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?
  reportText    String?       @db.Text
  toolCalls     Int           @default(0)
  inputTokens   Int           @default(0)
  outputTokens  Int           @default(0)
  pointsCharged Int?
  emailStatus   String? // sent | failed | skipped_no_config
  error         String?       @db.Text
  createdAt     DateTime      @default(now())
  task          ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([userId])
}
