  parent        NovelCheckpoint?  @relation("NovelCheckpointTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      NovelCheckpoint[] @relation("NovelCheckpointTree")

  @@index([projectId, branchName, createdAt])
  @@index([projectId, isHead])
}

model NovelPromptTemplate {
