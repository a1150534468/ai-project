  updatedAt          DateTime             @updatedAt
  project            NovelProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  foreshadow         NovelForeshadowItem? @relation(fields: [foreshadowId], references: [id], onDelete: SetNull)

  @@unique([projectId, sourceKey])
  @@index([projectId, status, dueChapter])
  @@index([foreshadowId])
}

model NovelForeshadowEvent {
  id           String              @id @default(cuid())
  projectId    String
  foreshadowId String
  chapterId    String?
  chapterIndex Int
  action       String
  evidence     String              @default("")
  confidence   Float               @default(0.7)
  source       String              @default("chapterPostprocess")
  sourceKey    String?
  createdAt    DateTime            @default(now())
  project      NovelProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  foreshadow   NovelForeshadowItem @relation(fields: [foreshadowId], references: [id], onDelete: Cascade)
  chapter      NovelChapter?       @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@unique([projectId, sourceKey])
  @@index([foreshadowId, chapterIndex])
  @@index([projectId, chapterIndex])
}

model NovelEntityState {
