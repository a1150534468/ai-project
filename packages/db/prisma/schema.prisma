  updatedAt       DateTime       @updatedAt
  project         NovelProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromCharacter   NovelCharacter @relation("NovelCharacterFrom", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  toCharacter     NovelCharacter @relation("NovelCharacterTo", fields: [toCharacterId], references: [id], onDelete: Cascade)

  @@unique([projectId, fromCharacterId, toCharacterId, relationType])
  @@index([projectId, relationType])
}

model NovelLocation {
