  updatedAt         DateTime                 @updatedAt
  project           NovelProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outgoingRelations NovelCharacterRelation[] @relation("NovelCharacterFrom")
  incomingRelations NovelCharacterRelation[] @relation("NovelCharacterTo")

  @@unique([projectId, name])
  @@index([projectId, role])
}

model NovelCharacterRelation {
  id              String         @id @default(cuid())
  projectId       String
  fromCharacterId String
  toCharacterId   String
  relationType    String
  description     String         @default("")
  strength        Float          @default(0.5)
  state           Json           @default("{}")
