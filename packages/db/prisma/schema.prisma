generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                       @id @default(cuid())
  uid                         String                       @unique
  username                    String                       @unique
  passwordHash                String
  bannedAt                    DateTime?
  memoryEnabled               Boolean                      @default(true)
  channelId                   String?
  createdAt                   DateTime                     @default(now())
  channel                     Channel?                     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  sessions                    Session[]
  agents                      UserAgent[]
  imageAssets                 ImageAsset[]
  imageGenerationTasks        ImageGenerationTask[]
  videoAssets                 VideoAsset[]
  videoGenerationTasks        VideoGenerationTask[]
  audioAssets                 AudioAsset[]
  audioGenerationTasks        AudioGenerationTask[]
  ecomWorkflows               EcomWorkflow[]
  articleWorkflowProjects     ArticleWorkflowProject[]
  localBusinessPromoProjects  LocalBusinessPromoProject[]
  localBusinessPromoRuns      LocalBusinessPromoRun[]
  novelProjects               NovelProject[]
  novelTasks                  NovelTask[]
  novelRuns                   NovelRun[]
  comicWorkflowProjects       ComicWorkflowProject[]
  comicWorkflowBibleEntries   ComicWorkflowBibleEntry[]
  comicWorkflowEpisodes       ComicWorkflowEpisode[]
  comicWorkflowScriptVersions ComicWorkflowScriptVersion[]
  comicWorkflowAssets         ComicWorkflowAsset[]
  comicWorkflowShots          ComicWorkflowShot[]
  agentTeams                  AgentTeam[]
  agentTeamMembers            AgentTeamMember[]
  agentWorkflowRuns           AgentWorkflowRun[]
  agentWorkflowSteps          AgentWorkflowStep[]
  agentWorkflowEvents         AgentWorkflowEvent[]
  loginEvents                 LoginEvent[]
  toolInstalls                UserToolInstall[]
  ecomMainImageJobs           EcomMainImageJob[]
  avatars                     Avatar[]
  skyhumanTasks               SkyhumanTask[]
  dubProjects                 DubProject[]
  scheduledTasks              ScheduledTask[]
  scheduledTaskRuns           ScheduledTaskRun[]

  @@index([channelId])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Session {
  id              String    @id @default(cuid())
  userId          String
  title           String    @default("新对话")
  agentId         String?
  agentName       String?
  agentPrompt     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        Message[]
  attachedKbIds   String[]  @default([])
  kbAttachAllOwn  Boolean   @default(false)
  attachedToolIds String[]  @default([])

  @@index([userId])
  @@index([userId, agentId])
}

model UserAgent {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  prompt      String
  modelUsed   String?
  avatarSvg   String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  model     String?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Memory {
  id         String                      @id @default(cuid())
  userId     String
  title      String                      @default("")
  text       String
  type       String                      @default("OTHER")
  importance Int                         @default(50)
  tags       Json                        @default("[]")
  embedding  Unsupported("vector(1024)")
  metadata   Json?
  lastUsedAt DateTime?
  usedCount  Int                         @default(0)
  createdAt  DateTime                    @default(now())

  @@index([userId])
  @@index([userId, type])
}

model Device {
  id           String    @id @default(cuid())
  userId       String
  name         String?
  platform     String
  appVersion   String    @default("")
  online       Boolean   @default(false)
  capabilities String[]  @default([])
  tools        Json      @default("[]")
  lastSeenAt   DateTime?
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model UserToolInstall {
  id          String   @id @default(cuid())
  userId      String
  categoryKey String
  marketId    String
  name        String
  description String   @default("")
  toolName    String
  status      String   @default("installed")
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, marketId])
  @@unique([userId, toolName])
  @@index([userId, updatedAt])
}

model DeviceSession {
  id             String    @id @default(cuid())
  deviceId       String
  userId         String
  appVersion     String
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  durationSec    Int?

  @@index([deviceId])
  @@index([userId, connectedAt])
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String // super_admin | admin
  permissions  String[] @default([])
  disabled     Boolean  @default(false)
  createdBy    String?
  createdAt    DateTime @default(now())
}

model AdminAudit {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  target    String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  active    Boolean   @default(true)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
}

model MetricsDaily {
  date           DateTime @id @db.Date
  registered     Int      @default(0)
  dau            Int      @default(0)
  wau            Int      @default(0)
  mau            Int      @default(0)
  newPayingUsers Int      @default(0)
  payingTotal    Int      @default(0)
  revenueFen     Int      @default(0)
  grantedPoints  Int      @default(0)
  consumedPoints Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model CohortDaily {
  cohortDate    DateTime @db.Date
  dayOffset     Int
  cohortSize    Int      @default(0)
  retained      Int      @default(0)
  cumRevenueFen Int      @default(0)
  cumPayers     Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@id([cohortDate, dayOffset])
}

model KnowledgeBase {
  id          String     @id @default(cuid())
  ownerType   String // "USER" | "OFFICIAL"
  userId      String?
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]

  @@index([userId])
  @@index([ownerType])
}

model Document {
  id         String        @id @default(cuid())
  kbId       String
  name       String
  sourceType String // "FILE" | "URL" | "TEXT"
  sourceUri  String?
  mime       String?
  sizeBytes  Int?
  status     String        @default("pending") // pending|indexing|indexed|failed
  error      String?
  chunkCount Int           @default(0)
  tokensUsed Int           @default(0)
  opId       String?
  lockedBy   String?
  lockedAt   DateTime?
  attempts   Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  kb         KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  chunks     Chunk[]

  @@index([kbId])
  @@index([status])
}

model Chunk {
  id         String                      @id @default(cuid())
  documentId String
  kbId       String
  ordinal    Int
  content    String
  embedding  Unsupported("vector(1024)")
  createdAt  DateTime                    @default(now())
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([kbId])
  @@index([documentId])
}

model KbQuotaPackage {
  id           String   @id @default(cuid())
  name         String
  bytes        Int
  durationDays Int      @default(0)
  pricePoints  Int
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model KbQuotaGrant {
  id        String    @id @default(cuid())
  userId    String
  bytes     Int
  source    String // PURCHASE | ADMIN
  expiresAt DateTime?
  opId      String?   @unique
  note      String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ImageAsset {
  id                      String               @id @default(cuid())
  userId                  String
  requestId               String
  requestIndex            Int
  prompt                  String
  model                   String
  size                    String
  originalUrl             String
  thumbnailUrl            String
  objectKey               String?
  mime                    String               @default("image/png")
  createdAt               DateTime             @default(now())
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  comicWorkflowAssets     ComicWorkflowAsset[]
  comicWorkflowShotImages ComicWorkflowShot[]

  @@unique([requestId, requestIndex])
  @@index([userId, createdAt])
}

model ImageGenerationTask {
  id                String   @id @default(cuid())
  userId            String
  requestId         String   @unique
  prompt            String
  model             String
  size              String
  referenceAssetIds String[] @default([])
  count             Int
  status            String   @default("running")
  completedCount    Int      @default(0)
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model VideoAsset {
  id           String   @id @default(cuid())
  userId       String
  requestId    String
  requestIndex Int      @default(0)
  prompt       String
  model        String
  aspectRatio  String
  resolution   String
  durationSec  Int
  originalUrl  String
  objectKey    String?
  mime         String   @default("video/mp4")
  format       String   @default("mp4")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, requestIndex])
  @@index([userId, createdAt])
}

model VideoGenerationTask {
  id             String    @id @default(cuid())
  userId         String
  requestId      String    @unique
  providerTaskId String?
  prompt         String
  model          String
  aspectRatio    String
  resolution     String
  durationSec    Int
  generateAudio  Boolean   @default(true)
  hasInputVideo  Boolean   @default(false)
  resourceKey    String
  chargedPoints  Int       @default(0)
  status         String    @default("running")
  progress       Int       @default(0)
  error          String?
  resultPayload  Json?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@index([providerTaskId])
}

// 上传的视频素材元数据：以对象 URL 为键缓存权威时长（秒），供「有输入视频」复合计费按输入时长扣费。
model VideoMaterial {
  id          String   @id @default(cuid())
  userId      String
  url         String   @unique
  objectKey   String?
  mime        String   @default("video/mp4")
  durationSec Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model AudioAsset {
  id                      String                      @id @default(cuid())
  userId                  String
  projectId               String?
  requestId               String?
  kind                    String
  source                  String
  provider                String?
  providerModel           String?
  originalUrl             String
  objectKey               String?
  mime                    String                      @default("audio/wav")
  format                  String                      @default("wav")
  durationSec             Int                         @default(0)
  textContent             String?
  metadata                Json?
  createdAt               DateTime                    @default(now())
  user                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                 LocalBusinessPromoProject?  @relation("LocalBusinessPromoProjectAudioAssets", fields: [projectId], references: [id], onDelete: SetNull)
  tasks                   AudioGenerationTask[]
  voiceCloneProjects      LocalBusinessPromoProject[] @relation("LocalBusinessPromoVoiceSample")
  activeNarrationProjects LocalBusinessPromoProject[] @relation("LocalBusinessPromoActiveNarration")
  activeBgmProjects       LocalBusinessPromoProject[] @relation("LocalBusinessPromoActiveBgm")

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([userId, kind, createdAt])
  @@index([requestId])
}

model AudioGenerationTask {
  id            String                     @id @default(cuid())
  userId        String
  projectId     String?
  requestId     String                     @unique
  kind          String
  provider      String?
  providerModel String?
  status        String                     @default("running")
  error         String?
  inputPayload  Json?
  resultPayload Json?
  assetId       String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  completedAt   DateTime?
  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       LocalBusinessPromoProject? @relation("LocalBusinessPromoProjectAudioTasks", fields: [projectId], references: [id], onDelete: SetNull)
  asset         AudioAsset?                @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([status, updatedAt])
}

model EcomWorkflow {
  id                  String   @id @default(cuid())
  userId              String
  platform            String
  language            String
  template            String
  resolution          String   @default("1K")
  segmentCount        Int      @default(3)
  product             Json
  referenceAssetIds   String[] @default([])
  masterAssetId       String?
  segments            Json     @default("[]")
  stitchedAssetId     String?
  stage               String   @default("draft")
  error               String?
  billingOperationIds String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, stage])
}

model LocalBusinessPromoProject {
  id                      String                  @id @default(cuid())
  userId                  String
  title                   String                  @default("未命名宣传项目")
  brief                   Json                    @default("{}")
  materials               Json                    @default("{}")
  settings                Json                    @default("{}")
  scriptDraft             String                  @default("")
  latestRunId             String?
  voiceCloneSampleAssetId String?
  activeNarrationAssetId  String?
  activeBgmAssetId        String?
  status                  String                  @default("draft")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs                    LocalBusinessPromoRun[]
  audioAssets             AudioAsset[]            @relation("LocalBusinessPromoProjectAudioAssets")
  audioTasks              AudioGenerationTask[]   @relation("LocalBusinessPromoProjectAudioTasks")
  voiceCloneSampleAsset   AudioAsset?             @relation("LocalBusinessPromoVoiceSample", fields: [voiceCloneSampleAssetId], references: [id], onDelete: SetNull)
  activeNarrationAsset    AudioAsset?             @relation("LocalBusinessPromoActiveNarration", fields: [activeNarrationAssetId], references: [id], onDelete: SetNull)
  activeBgmAsset          AudioAsset?             @relation("LocalBusinessPromoActiveBgm", fields: [activeBgmAssetId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([voiceCloneSampleAssetId])
  @@index([activeNarrationAssetId])
  @@index([activeBgmAssetId])
}

model LocalBusinessPromoRun {
  id                         String                    @id @default(cuid())
  projectId                  String
  userId                     String
  billingOperationId         String?
  billingRefundedAt          DateTime?
  billingRefundStatus        String                    @default("none")
  billingRefundError         String?
  billingRefundRetryCount    Int                       @default(0)
  billingRefundLastAttemptAt DateTime?
  billingRefundNextRetryAt   DateTime?
  settingsSnapshot           Json                      @default("{}")
  scriptSnapshot             String                    @default("")
  shotPlan                   Json                      @default("[]")
  analysisSnapshot           Json?
  clipRequestIds             String[]                  @default([])
  mergedAssetId              String?
  narrationAssetId           String?
  bgmAssetId                 String?
  status                     String                    @default("queued")
  progressPercent            Int                       @default(0)
  progressStage              String                    @default("queued")
  progressMessage            String?
  error                      String?
  startedAt                  DateTime?
  workerId                   String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  completedAt                DateTime?
  project                    LocalBusinessPromoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@index([billingRefundStatus, billingRefundNextRetryAt])
}

model ArticleWorkflowProject {
  id                String   @id @default(cuid())
  userId            String
  sourceFormat      String
  sourceText        String
  generationMode    String   @default("preserve-text")
  title             String   @default("")
  summary           String   @default("")
  bodyHtml          String   @default("")
  imageManifestJson Json     @default("[]")
  status            String   @default("draft")
  progressStage     String   @default("draft")
  progressPercent   Int      @default(0)
  progressMessage   String?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, status])
}

model EcomMainImageJob {
  id                  String   @id @default(cuid())
  userId              String
  platform            String
  language            String
  ratio               String
  resolution          String   @default("1K")
  style               String
  customStyle         String   @default("")
  withText            Boolean  @default(true)
  product             Json
  referenceAssetIds   String[] @default([])
  count               Int
  images              Json     @default("[]")
  stage               String   @default("draft")
  error               String?
  billingOperationIds String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, stage])
}

model NovelProject {
  id                    String                    @id @default(cuid())
  userId                String
  title                 String
  genre                 String                    @default("")
  premise               String                    @default("")
  settings              Json                      @default("{}")
  generationPrefs       Json                      @default("{}")
  narrativeContract     Json                      @default("{}")
  targetChapters        Int                       @default(100)
  targetCharsPerChapter Int                       @default(3000)
  setupStage            Int                       @default(1)
  setupCompleted        Boolean                   @default(false)
  storyPhase            String                    @default("opening")
  autopilotStatus       String                    @default("idle")
  currentBranch         String                    @default("main")
  status                String                    @default("active")
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters              NovelChapter[]
  tasks                 NovelTask[]
  vectorMemories        NovelVectorMemory[]
  knowledgeFacts        NovelKnowledgeFact[]
  foreshadowItems       NovelForeshadowItem[]
  runs                  NovelRun[]
  runEvents             NovelRunEvent[]
  outboxCommands        NovelCommandOutbox[]
  structureNodes        NovelStructureNode[]
  characters            NovelCharacter[]
  characterRelations    NovelCharacterRelation[]
  locations             NovelLocation[]
  timelineEvents        NovelTimelineEvent[]
  storylines            NovelStoryline[]
  storylineMilestones   NovelStorylineMilestone[]
  props                 NovelProp[]
  propEvents            NovelPropEvent[]
  narrativeEvents       NovelNarrativeEvent[]
  causalEdges           NovelCausalEdge[]
  narrativeDebts        NovelNarrativeDebt[]
  entityStates          NovelEntityState[]
  qualityReports        NovelQualityReport[]
  checkpoints           NovelCheckpoint[]
  promptTemplates       NovelPromptTemplate[]
  bible                 NovelBible?
  worldDimensions       NovelWorldDimension[]
  styleNotes            NovelStyleNote[]

  @@index([userId, updatedAt])
}

model NovelBible {
  id              String                @id @default(cuid())
  projectId       String                @unique
  premiseLock     String                @default("")
  genreLock       String                @default("")
  worldPresetLock String                @default("")
  version         Int                   @default(1)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  project         NovelProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worldDimensions NovelWorldDimension[]
  styleNotes      NovelStyleNote[]
}

model NovelWorldDimension {
  id           String       @id @default(cuid())
  projectId    String
  bibleId      String
  dimensionKey String
  title        String
  summary      String       @default("")
  details      Json         @default("{}")
  position     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  project      NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bible        NovelBible   @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@unique([projectId, dimensionKey])
  @@index([bibleId, position])
}

model NovelStyleNote {
  id        String       @id @default(cuid())
  projectId String
  bibleId   String
  category  String
  title     String
  content   String
  position  Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  project   NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bible     NovelBible   @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@unique([projectId, category, title])
  @@index([bibleId, position])
}

model NovelVectorMemory {
  id          String                      @id @default(cuid())
  projectId   String
  sourceType  String
  sourceId    String
  sourceKind  String
  title       String                      @default("")
  content     String
  contentHash String
  embedding   Unsupported("vector(1024)")
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  project     NovelProject                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceType, sourceId])
  @@index([projectId, sourceKind])
  @@index([projectId, updatedAt])
}

model NovelChapter {
  id               String                @id @default(cuid())
  projectId        String
  volumeIndex      Int                   @default(1)
  chapterIndex     Int
  title            String                @default("")
  summary          String                @default("")
  outline          String                @default("")
  generationHint   String                @default("")
  executionPlan    Json?
  microBeats       Json                  @default("[]")
  content          String                @default("")
  rawContent       String                @default("")
  openThreads      Json                  @default("[]")
  contextSnapshot  Json?
  generationMeta   Json?
  consistencyJson  Json?
  status           String                @default("draft")
  reviewStatus     String                @default("pending")
  reviewNotes      String                @default("")
  aiReview         String                @default("")
  aiActionItems    Json                  @default("[]")
  modificationRate Int                   @default(0)
  reviewedAt       DateTime?
  tensionScore     Float                 @default(0)
  plotTension      Float                 @default(0)
  emotionalTension Float                 @default(0)
  pacingTension    Float                 @default(0)
  qualityScore     Float                 @default(0)
  billableChars    Int                   @default(0)
  lastTaskId       String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  project          NovelProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions         NovelChapterVersion[]
  qualityReports   NovelQualityReport[]

  @@unique([projectId, chapterIndex])
  @@index([projectId, updatedAt])
  @@index([projectId, reviewStatus])
}

model NovelKnowledgeFact {
  id            String       @id @default(cuid())
  projectId     String
  chapterId     String?
  chapterIndex  Int?
  subject       String
  predicate     String
  object        String
  sourceExcerpt String       @default("")
  confidence    Float        @default(0.7)
  status        String       @default("confirmed")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  project       NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, chapterIndex, subject, predicate, object])
  @@index([projectId, status])
  @@index([projectId, updatedAt])
}

model NovelForeshadowItem {
  id                       String       @id @default(cuid())
  projectId                String
  introducedInChapterId    String?
  introducedInChapterIndex Int?
  title                    String
  description              String       @default("")
  expectedPayoffChapter    Int          @default(0)
