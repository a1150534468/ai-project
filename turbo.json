{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "test": {
      "dependsOn": ["^build"],
      // 这些变量必须放 env 而非 passThroughEnv：passThroughEnv 只透传、不参与缓存哈希，
      // 于是缓存命中会重放「换了 env 的旧结果」——包括没 source .env 时被 skipIf 静默跳过的那一次。
      // 放进 env 后 env 一变即失效缓存。CI 另加 --force 兜底，保证 skip 计数防护读到的是真跑出来的报告。
      "env": [
        "ADMIN_SESSION_SECRET",
        "BAILIAN_API_KEY",
        "BAILIAN_REGION",
        "BAILIAN_WORKSPACE_ID",
        "BILLING_BASE_URL",
        "BILLING_DATABASE_URL",
        "BILLING_INTERNAL_TOKEN",
        "CHATGPT_API_KEY",
        "CHATGPT_BASE_URL",
        "CHATGPT_MODELS",
        "DATABASE_URL",
        "DUB_PARSE_CLIENT_ID",
        "DUB_PARSE_SECRET_KEY",
        "EMBEDDING_API_KEY",
        "EMBEDDING_BASE_URL",
        "EMBEDDING_MODEL",
        "IMAGE_API_KEY",
        "IMAGE_BASE_URL",
        "IMAGE_EDIT_ENDPOINT",
        "IMAGE_GENERATION_ENDPOINT",
        "IMAGE_GENERATION_MODEL",
        "IMAGE_MAX_ATTEMPTS",
        "GPT_IMAGE_API_KEY",
        "GPT_IMAGE_EDIT_API_KEY",
        "GPT_IMAGE_EDIT_ENDPOINT",
        "GPT_IMAGE_GENERATION_ENDPOINT",
        "PET_VISUAL_QA_MODEL",
        "CODEX_PET_ARTIFACT_SIGNING_SECRET",
        "LLM_API_KEY",
        "LLM_BASE_URL",
        "LLM_DEFAULT_MODEL",
        "MIMO_API_KEY",
        "MIMO_BASE_URL",
        "REDIS_URL",
        "S3_ACCESS_KEY",
        "S3_BUCKET",
        "S3_ENDPOINT",
        "S3_FORCE_PATH_STYLE",
        "S3_PUBLIC_BASE_URL",
        "S3_REGION",
        "S3_SECRET_KEY",
        "SESSION_SECRET",
        "SKYHUMAN_API_TOKEN",
        "SKYHUMAN_BASE_URL",
        "SKYHUMAN_CALLBACK_SECRET",
        "TOAPIS_API_KEY",
        "VIDEO_ANALYZE_MODEL",
        "VIDEO_API_KEY"
      ]
    },
    "typecheck": { "dependsOn": ["^build"] }
  }
}
