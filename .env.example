# NewAPI 作为纯 LLM 网关（Anthropic 兼容端点）
LLM_BASE_URL=
LLM_API_KEY=
LLM_DEFAULT_MODEL=
# 视频/图片理解模型（gemini 原生 inline_data；必须能听见视频音轨才能转写口播文稿）
VIDEO_ANALYZE_MODEL=gemini-2.5-flash

# 基础设施
DATABASE_URL=
REDIS_URL=
SESSION_SECRET=
PORT=8090

# CORS：生产填逗号分隔白名单（如 https://app.example.com）；留空则 dev 放开
CORS_ORIGIN=

# 计费服务
BILLING_BASE_URL=http://localhost:8093
BILLING_INTERNAL_TOKEN=
# standard=现有真实计价；learning=每个 operationId 从原有账户扣 1 点（普通功能扣积分，视频扣视频点）
BILLING_PRICING_MODE=standard

# 长期记忆（embedding + 要点抽取）
# EMBEDDING_BASE_URL= # 默认复用 LLM_BASE_URL
# EMBEDDING_API_KEY= # 默认复用 LLM_API_KEY
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
# EMBEDDING_DIM=
# MEMORY_EXTRACT_MODEL= # 默认复用 LLM_DEFAULT_MODEL

# 数字人口播（飞天数字人 · P1）
SKYHUMAN_API_TOKEN=                              # 飞天平台 token（个人中心获取），未配置则数字人口播整体不可用
SKYHUMAN_BASE_URL=https://skyhumanapi.pilihu.vip
SKYHUMAN_CALLBACK_SECRET=                        # 回调 secret（随机 ≥32），飞天控制台回调 URL 带 ?secret= 用
SKYHUMAN_MAX_INFLIGHT=3                           # 飞天并发任务上限（Redis 信号量，防 1001）

# 数字人口播 · 配音（MiMo TTS · P2）
MIMO_API_KEY=                                    # 小米 MiMo 平台 key，未配置则配音不可用
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# 数字人口播 · 链接解析（ppt6）
DUB_PARSE_BASE_URL=http://apis.ppt6.top          # 解析服务地址
DUB_PARSE_CLIENT_ID=                             # ppt6 clientId，未配置则粘贴链接解析不可用（502）
DUB_PARSE_SECRET_KEY=                            # ppt6 clientSecretKey（绝不入库）
DUB_PARSE_QUOTA_PER_HOUR=20                      # 每用户每小时解析次数上限

# 对象存储（S3/MinIO）
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# 知识库（KB）调优
KB_MAX_FILE_BYTES=20971520        # 单文件上限 20MB
KB_MAX_TEXT_CHARS=200000          # 粘贴文本上限
KB_BYTES_PER_TOKEN=3              # token 估算（预扣用）
KB_CHUNK_TOKENS=800               # 分块大小
KB_CHUNK_OVERLAP=100              # 分块重叠
KB_MAX_CHUNKS=2000                # 单文档最大块数
KB_EMBED_CONCURRENCY=4            # 索引 embed 并发
KB_TOPK=6                         # 检索 topK
KB_RETRIEVE_TIMEOUT_MS=3000       # 检索超时（降级）
KB_REAPER_INTERVAL_MS=30000       # reaper 周期
KB_INDEX_LEASE_MS=300000          # 索引租约（崩溃重拾）
KB_MAX_ATTEMPTS=3                 # 最大重试
KB_URL_MAX_REDIRECTS=3            # URL 抓取最大跳转
KB_URL_MAX_BYTES=10485760         # URL 抓取大小上限 10MB
KB_URL_FETCH_TIMEOUT_MS=15000     # URL 抓取超时
