# 阿里云百炼（默认）：北京地域需要业务空间 ID，地址会自动拼成
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/apps/anthropic
LLM_PROVIDER=bailian
BAILIAN_WORKSPACE_ID=
BAILIAN_REGION=cn-beijing
BAILIAN_API_KEY=
# 若使用自定义 Anthropic 兼容地址，可直接设置，优先级高于自动拼接地址。
# BAILIAN_BASE_URL=
LLM_DEFAULT_MODEL=qwen3.7-plus
CHAT_MULTIMODAL_MODEL=qwen3.7-plus

# 仅作为旧 NewAPI/Anthropic 兼容网关回退：把 LLM_PROVIDER 改为 anthropic 后填写。
LLM_BASE_URL=
LLM_API_KEY=

# 图片生成与编辑：Qwen Image 2.0 Pro 默认复用上面的百炼 API Key，
# 走 DashScope 公共模型标准端点；不拼 Workspace 专属域名。
IMAGE_GENERATION_MODEL=qwen-image-2.0-pro-2026-04-22
# 仅在图片使用独立百炼凭据、自定义模型或自定义入口时覆盖：
# IMAGE_API_KEY=
# IMAGE_BASE_URL=https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com
# IMAGE_GENERATION_ENDPOINT=
# IMAGE_EDIT_ENDPOINT=

# 豆包 Seedream 4.5：使用火山 Ark 原生图片接口。
# ARK_API_KEY=
# ARK_IMAGE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations

# GPT Image 2：OpenAI Images API 兼容生成接口。Key 仅填本机 .env 或部署 Secret，禁止提交。
GPT_IMAGE_GENERATION_ENDPOINT=https://api.ai-pixel.online/v1/images/generations
GPT_IMAGE_API_KEY=
# 可选：本机代理使用 fake DNS 且长请求会被中间层断开时，为 Pixel host 指定真实 IP；默认留空。
# CODEX_PET_UPSTREAM_RESOLVE_IP=
# 可选：为每次 Pixel 请求创建与 Node 默认配置一致的独立 Agent，避免复用老化 socket。
# CODEX_PET_UPSTREAM_FRESH_AGENT=1
# 可选：仅在使用上方固定 IP / isolated Agent 时关闭 H2 协商；默认启用 H2。
# CODEX_PET_UPSTREAM_ALLOW_H2=0
# 可选：Pixel 账号需要在不同桌宠 job 之间释放并发槽时，设置 fetch 前冷却时间。
# CODEX_PET_IMAGE_DISPATCH_COOLDOWN_MS=45000
# OpenAI Images edits（桌宠与普通生图参考图共用）；endpoint 未配时由 generations 自动推导。
GPT_IMAGE_EDIT_ENDPOINT=https://api.ai-pixel.online/v1/images/edits
# GPT_IMAGE_EDIT_API_KEY=                     # 可选；留空复用 GPT_IMAGE_API_KEY
# RUN_GPT_IMAGE_EDIT_POC=1                    # 仅部署/切网关/升级模型时显式开启真实 POC
# 普通生图上游瞬时错误的最大尝试次数（初次请求 + 重试），默认 3。
IMAGE_MAX_ATTEMPTS=3

# Codex 桌宠 Worker / QA / 私有安装链接
PET_VISUAL_QA_MODEL=gpt-5.6-sol
CODEX_PET_WORKER_CONCURRENCY=1
# 一条运行内并发生图的上限（上限 3），默认 1。>1 会让同一条运行的多次付费生图
# 抢同一份上游 relay 配额，自己把自己打成 429，除非确认上游余量充足否则别调高。
CODEX_PET_VISUAL_CONCURRENCY=1
# 下面三项按次计费下保持默认（都是 3）即可，真实验收也不要设成 1。
# CODEX_PET_IMAGE_MAX_ATTEMPTS 管的是「传输轴」：同一次**已付费**调用因 socket 抖动的
# 免费重发（回到同一条流水行、不产生新计费单位）。设成 1 会让一次网络抖动就把运行停到
# 等待批准、还要你再授权付一次——那正是要避免的白花钱形状。
# CODEX_PET_MAX_BOARD_ATTEMPTS 在按次计费下不生效：质量轴的重画由用户逐次授权放行。
# CODEX_PET_MAX_BOARD_ATTEMPTS=3
# CODEX_PET_IMAGE_MAX_ATTEMPTS=3
# CODEX_PET_VISUAL_MAX_ATTEMPTS=3
CODEX_PET_HEARTBEAT_MS=10000
CODEX_PET_STALE_RUN_MS=900000
CODEX_PET_MAINTENANCE_MS=60000
CODEX_PET_WORKER_HEALTH_PORT=8092
CODEX_PET_HEALTH_STALE_MS=120000
CODEX_PET_ARCHIVE_MAX_ATTEMPTS=10
CODEX_PET_CLEANUP_ATTEMPTS=120
CODEX_PET_CLEANUP_BACKOFF_MS=10000
CODEX_PET_CLEANUP_RECOVERY_LIMIT=100
# 按次计费护栏（默认值即生产建议值，调之前先读 docs/codex-pet.md 4.5）
# CODEX_PET_EXTRA_IMAGE_CALLS_PER_JOB_LIMIT=4   # 单个动作最多允许几次付费额外生图
# CODEX_PET_EXTRA_IMAGE_CALLS_PER_RUN_LIMIT=12  # 单次运行最多允许几次付费额外生图
# CODEX_PET_FAILED_SETTLEMENT_GRACE_MS=86400000 # 失败运行保留预留、可续跑的窗口期
# CODEX_PET_PUBLIC_BASE_URL=https://api.example.com  # 安装深链中的 30 分钟 HTTPS 精灵图地址
# CODEX_PET_ARTIFACT_SIGNING_SECRET=          # 可选；>=32 字节，留空复用 SESSION_SECRET

# AI Pixel 对话模型：使用 Anthropic Messages 兼容协议。
# CHATGPT_API_KEY 留空时自动复用 GPT_IMAGE_API_KEY。
CHATGPT_BASE_URL=https://api.ai-pixel.online
CHATGPT_MODELS=codex-auto-review,gpt-5.4,gpt-5.4-mini,gpt-5.5,gpt-5.6-luna,gpt-5.6-sol,gpt-5.6-terra
# CHATGPT_API_KEY=

# 视频/图片理解当前仍是 Gemini 原生协议，迁移该工作流时再切到百炼视觉/全模态接口。
VIDEO_ANALYZE_MODEL=gemini-2.5-flash

# 基础设施
DATABASE_URL=postgresql://ai-assistant:postgres-password-placeholder@localhost:5433/ai-assistant
REDIS_URL=redis://localhost:6380
SESSION_SECRET=local-session-secret-change-me-at-least-32-chars
ADMIN_SESSION_SECRET=local-admin-secret-change-me-at-least-32-chars
PORT=8090
GATEWAY_HTTP_PORT=18080

# 轻量 Worker / 媒体运行时（生产建议从 1 开始，按服务器实测调整）
WORKER_CONCURRENCY=1
HEAVY_TASK_CONCURRENCY=1
WORKER_HEALTH_PORT=8091
LOCAL_BUSINESS_PROMO_WORKER_CONCURRENCY=1
NOVEL_WORKER_CONCURRENCY=1
FFMPEG_THREADS=1
SHARP_CONCURRENCY=1
SHARP_CACHE_MEMORY_MB=32
SHARP_CACHE_FILES=10
SHARP_CACHE_ITEMS=50
QUEUE_COMPLETED_JOB_COUNT=100
QUEUE_FAILED_JOB_COUNT=200
TEMP_MIN_FREE_BYTES=2147483648

# CORS：生产填逗号分隔白名单（如 https://app.example.com）；留空则 dev 放开
CORS_ORIGIN=

# 计费服务
BILLING_BASE_URL=http://localhost:8093
# Swagger/OpenAPI：默认开启；生产环境可设为 false，或在网关层保护 /docs。
API_DOCS_ENABLED=true
API_DOCS_BASE_URL=http://localhost:8090
BILLING_DOCS_BASE_URL=http://localhost:8093
BILLING_DATABASE_URL=postgresql://ai_assistant_billing:billing-postgres-password-placeholder@localhost:5434/ai_assistant_billing
BILLING_INTERNAL_TOKEN=local-billing-internal-token
BILLING_PORT=8093
# standard=现有真实计价；learning=每个 operationId 从原有账户扣 1 点（普通功能扣积分，视频扣视频点）
BILLING_PRICING_MODE=standard

# 长期记忆与知识库：默认复用 BAILIAN_API_KEY 调用百炼 OpenAI 兼容向量接口。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY= # 可选；不填则复用 BAILIAN_API_KEY / DASHSCOPE_API_KEY
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
# MEMORY_EXTRACT_MODEL= # 默认复用 LLM_DEFAULT_MODEL

# 数字人口播（飞天数字人 · P1）
SKYHUMAN_API_TOKEN=                              # 飞天平台 token（个人中心获取），未配置则数字人口播整体不可用
SKYHUMAN_BASE_URL=https://skyhumanapi.pilihu.vip
SKYHUMAN_CALLBACK_SECRET=                        # 回调 secret（随机 ≥32），飞天控制台回调 URL 带 ?secret= 用
SKYHUMAN_MAX_INFLIGHT=3                           # 飞天并发任务上限（Redis 信号量，防 1001）

# 数字人口播 · 配音（MiMo TTS · P2）
MIMO_API_KEY=                                    # 小米 MiMo 平台 key，未配置则配音不可用
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# 数字人口播 · 链接解析（ppt6）
DUB_PARSE_BASE_URL=http://apis.ppt6.top          # 解析服务地址
DUB_PARSE_CLIENT_ID=                             # ppt6 clientId，未配置则粘贴链接解析不可用（502）
DUB_PARSE_SECRET_KEY=                            # ppt6 clientSecretKey（绝不入库）
DUB_PARSE_QUOTA_PER_HOUR=20                      # 每用户每小时解析次数上限

# 对象存储（S3/MinIO）
MINIO_ROOT_USER=minio-access-key-placeholder
MINIO_ROOT_PASSWORD=minio-secret-key-placeholder
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-assistant-local
S3_ACCESS_KEY=minio-access-key-placeholder
S3_SECRET_KEY=minio-secret-key-placeholder
S3_FORCE_PATH_STYLE=true

# 知识库（KB）调优
KB_MAX_FILE_BYTES=20971520        # 单文件上限 20MB
KB_MAX_TEXT_CHARS=200000          # 粘贴文本上限
KB_BYTES_PER_TOKEN=3              # token 估算（预扣用）
KB_CHUNK_TOKENS=800               # 分块大小
KB_CHUNK_OVERLAP=100              # 分块重叠
KB_MAX_CHUNKS=2000                # 单文档最大块数
KB_EMBED_CONCURRENCY=4            # 索引 embed 并发
KB_TOPK=6                         # 检索 topK
KB_RETRIEVE_TIMEOUT_MS=3000       # 检索超时（降级）
KB_REAPER_INTERVAL_MS=30000       # reaper 周期
KB_INDEX_LEASE_MS=300000          # 索引租约（崩溃重拾）
KB_MAX_ATTEMPTS=3                 # 最大重试
KB_URL_MAX_REDIRECTS=3            # URL 抓取最大跳转
KB_URL_MAX_BYTES=10485760         # URL 抓取大小上限 10MB
KB_URL_FETCH_TIMEOUT_MS=15000     # URL 抓取超时

# ===== 2026-08-17 补齐：此前代码读取但未文档化的配置 =====

# HTTP 服务
# API_BODY_LIMIT_BYTES=31457280              # Fastify bodyLimit（默认 30MB）
# API_PUBLIC_BASE_URL=                       # Codex 桌宠产物对外基础地址（签名 URL 回源用）
# NODE_ENV=development                       # 标准 Node 运行环境（dev/production/test）

# 对话与流式（agent/run.ts 调参）
# CHAT_MAX_CONTINUATIONS=3                   # 单轮最大连续续写次数
# CHAT_MAX_OUTPUT_TOKENS=8192                # 单次输出上限
# CHAT_STREAM_IDLE_TIMEOUT_MS=30000          # 流式空闲超时
# CHAT_STREAM_MAX_RETRIES=3                  # 流式最大重试
# CHAT_STREAM_TOTAL_TIMEOUT_MS=300000        # 流式总超时

# Connector（本地工具/断连）
# CONNECTOR_DISCONNECT_GRACE_MS=10000        # 断连宽限期
# CONNECTOR_TOOL_TIMEOUT_MS=60000            # 工具调用超时

# Workflow 各域调参
# ECOM_HELP_WRITE_MODEL=                     # 电商帮写模型（默认跟随 LLM_DEFAULT_MODEL）
# CODEX_PET_IMAGE_APPROVAL_GATE=1            # 桌宠生成图是否需人工审批（1 开 0 关）
# NOVEL_EXPORT_CJK_FONT=                     # 小说导出 CJK 字体路径（默认内置）
# NOVEL_WORKER_CONCURRENCY=1                 # 小说 worker 并发
# NOVEL_WORKER_HEALTH_PORT=                   # 小说 worker 健康检查端口
# PLATFORM_CHANNEL_CODE=                     # 渠道码（reseller seed）
# S3_PUBLIC_BASE=                            # 报告导出的 S3 公网基础地址
# S3_PUBLIC_BASE_URL=                        # 报告导出的 S3 公网完整 URL（两者选一）
# SCHED_AI_DRAFT_MODEL=                      # 定时任务 AI 草稿模型（默认跟随 LLM_DEFAULT_MODEL）
# SEED_ADMIN_USERNAME=                       # admin 种子账号（admin/seed.ts）
# SEED_ADMIN_PASSWORD=                       # admin 种子密码（仅本地/测试用）
# TOOL_INSTALL_TIMEOUT_MS=120000             # 工具安装超时
# TOOL_MARKET_DOWNLOAD_BASE_URL=             # 工具市场下载基础地址
# VIDEO_MAX_BYTES=                           # 视频上传大小上限（video-service）
# VIDEO_REF_MAX_BYTES=                       # 视频参考图大小上限（video-routes）
# DASHSCOPE_API_KEY=                         # 百炼 DashScope 直连 key（Qwen 生图后备，缺省复用 BAILIAN_API_KEY）

# Go 计费服务（services/billing，复用同一份 env）
# EPAY_PID=                                  # 易支付商户号
# EPAY_KEY=                                  # 易支付密钥
# EPAY_GATEWAY=                              # 易支付网关地址
# PUBLIC_CALLBACK_BASE=                      # 支付回调公网基础地址
# DOUBAO_IMAGE_MODEL=                        # 豆包 Seedream 模型名（registry 计价）
# QWEN_IMAGE_MODEL=                          # Qwen 生图模型名（registry 计价）
# GPT_IMAGE_MODEL=                           # GPT Image 模型名（registry 计价）
