{
  "name": "ai-assistant",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "bash scripts/dev-local.sh",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d --no-recreate postgres redis billing-postgres minio",
    "dev:infra:stop": "docker compose -f docker-compose.dev.yml stop",
    "dev:desktop": "pnpm --filter @ai-assistant/desktop dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "typecheck": "pnpm --filter @ai-assistant/db generate && turbo run typecheck",
    "k8s:validate": "kubectl kustomize infra/k8s/base >/dev/null"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "prisma": "6.19.3",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
