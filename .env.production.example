# Image registry and namespace. Repository names are ai-assistant-{api,gateway,migrate,billing}.
IMAGE_REGISTRY=ccr.ccs.tencentyun.com
IMAGE_NAMESPACE=indz
IMAGE_TAG=latest

APP_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
GATEWAY_HTTP_PORT=18080

# URL-encode passwords before placing them in connection strings.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://ai-assistant:replace-with-a-long-random-password@postgres:5432/ai-assistant?connection_limit=8&pool_timeout=10
WORKER_DATABASE_URL=postgresql://ai-assistant:replace-with-a-long-random-password@postgres:5432/ai-assistant?connection_limit=5&pool_timeout=10
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Tencent COS S3-compatible endpoint. Do not deploy MinIO in production.
S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
S3_REGION=ap-guangzhou
S3_BUCKET=replace-with-cos-bucket
S3_ACCESS_KEY=replace-with-cos-secret-id
S3_SECRET_KEY=replace-with-cos-secret-key
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=https://replace-with-cos-public-domain

WORKER_CONCURRENCY=1
HEAVY_TASK_CONCURRENCY=1
FFMPEG_THREADS=1
SHARP_CONCURRENCY=1
SHARP_CACHE_MEMORY_MB=32
SHARP_CACHE_FILES=10
SHARP_CACHE_ITEMS=50
QUEUE_COMPLETED_JOB_COUNT=100
QUEUE_FAILED_JOB_COUNT=200
TEMP_MIN_FREE_BYTES=2147483648
VIDEO_MAX_BYTES=367001600
VIDEO_MATERIAL_MAX_BYTES=367001600

# Copy the provider variables required by the enabled features from .env.example.
LLM_PROVIDER=bailian
BAILIAN_WORKSPACE_ID=replace-with-bailian-workspace-id
BAILIAN_REGION=cn-beijing
BAILIAN_API_KEY=replace-with-bailian-api-key
LLM_DEFAULT_MODEL=qwen3.7-plus
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=replace-with-embedding-api-key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
GPT_IMAGE_API_KEY=replace-with-gpt-image-api-key
GPT_IMAGE_GENERATION_ENDPOINT=https://api.ai-pixel.online/v1/images/generations
GPT_IMAGE_EDIT_ENDPOINT=https://api.ai-pixel.online/v1/images/edits
CHATGPT_BASE_URL=https://api.ai-pixel.online
CHATGPT_MODELS=codex-auto-review,gpt-5.4,gpt-5.4-mini,gpt-5.5,gpt-5.6-luna,gpt-5.6-sol,gpt-5.6-terra
API_DOCS_ENABLED=false
