{
  "name": "@yc/desktop",
  "version": "1.0.22",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:win": "node scripts/fetch-vcredist.mjs && pnpm run build && electron-builder --win --x64 --config electron-builder.config.cjs --publish never",
    "publish:win": "pnpm run dist:win && node scripts/publish-s3-release.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yc/connector-protocol": "workspace:*",
    "electron-updater": "^6.8.9",
    "tinyglobby": "^0.2.10",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
