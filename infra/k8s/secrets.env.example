# 复制为 secrets.env（已 gitignore），填真实值后跑 create-secrets.sh。
# === api（ai-assistant-api-secrets）===
SESSION_SECRET=
DATABASE_URL=
REDIS_URL=
BAILIAN_WORKSPACE_ID=
BAILIAN_API_KEY=
# 旧 Anthropic/NewAPI 网关回退时才填写 LLM_API_KEY。
LLM_API_KEY=
# 可选：不填则生图复用 BAILIAN_API_KEY。
IMAGE_API_KEY=
# GPT Image 2 的 OpenAI Images API 兼容服务凭据。
GPT_IMAGE_API_KEY=
# 豆包 Seedream 文生图（火山方舟）凭据；不填则模型广场的豆包卡片生图时返回 401。
ARK_API_KEY=
# 可选：火山方舟生图端点；留空则用默认 https://ark.cn-beijing.volces.com/api/v3/images/generations
ARK_IMAGE_ENDPOINT=
# 可选：桌宠和普通生图 edits 使用独立凭据；留空时复用 GPT_IMAGE_API_KEY。
GPT_IMAGE_EDIT_API_KEY=
# 可选：独立的桌宠安装签名密钥（>=32 字节）；留空时复用 SESSION_SECRET。
CODEX_PET_ARTIFACT_SIGNING_SECRET=
# 可选：AI Pixel 对话使用独立凭据；留空时自动复用 GPT_IMAGE_API_KEY。
CHATGPT_API_KEY=
ADMIN_SESSION_SECRET=
# 知识库对象存储（天翼云 OOS AK/SK；KB 未就绪可留空，api 优雅降级）
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 可选：小米 MiMo key；配音下线后仓内已无读取方，留空只会让 api 启动时多打一条
