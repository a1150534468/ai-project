# 复制为 secrets.env（已 gitignore），填真实值后跑 create-secrets.sh。
# === api（ai-assistant-api-secrets）===
SESSION_SECRET=
DATABASE_URL=
REDIS_URL=
BAILIAN_WORKSPACE_ID=
BAILIAN_API_KEY=
# 旧 Anthropic/NewAPI 网关回退时才填写 LLM_API_KEY。
LLM_API_KEY=
# 可选：不填则生图复用 BAILIAN_API_KEY。
IMAGE_API_KEY=
# GPT Image 2 的 OpenAI Images API 兼容服务凭据。
GPT_IMAGE_API_KEY=
# 可选：桌宠和普通生图 edits 使用独立凭据；留空时复用 GPT_IMAGE_API_KEY。
GPT_IMAGE_EDIT_API_KEY=
# 可选：独立的桌宠安装签名密钥（>=32 字节）；留空时复用 SESSION_SECRET。
CODEX_PET_ARTIFACT_SIGNING_SECRET=
# 可选：AI Pixel 对话使用独立凭据；留空时自动复用 GPT_IMAGE_API_KEY。
CHATGPT_API_KEY=
# 必填：视频生成上游（toapis/Seedance）key，无回退，缺则视频生成必挂。
VIDEO_API_KEY=
BILLING_INTERNAL_TOKEN=
ADMIN_SESSION_SECRET=
# 知识库对象存储（天翼云 OOS AK/SK；KB 未就绪可留空，api 优雅降级）
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 图/视频生成上游（toapis）；线上 Secret 已有此 key，留空则保持线上原值不变。
TOAPIS_API_KEY=
# 数字人口播：飞天数字人（对口型）+ 小米 MiMo（TTS）。三者留空则该功能整体降级：
# dub 端点返 502、reaper 不启动，其余功能不受影响。非敏感的 *_BASE_URL 在 configmap。
SKYHUMAN_API_TOKEN=
# 飞天回调无签名，用不可猜的 secret 当门；须与飞天控制台回调 URL 上的 ?secret= 完全一致。
SKYHUMAN_CALLBACK_SECRET=
MIMO_API_KEY=
# 数字人链接解析（ppt6）：留空则粘贴链接解析端点返 502。非敏感的 BASE_URL/QUOTA 走 configmap/默认值。
DUB_PARSE_CLIENT_ID=
DUB_PARSE_SECRET_KEY=
# === billing（ai-assistant-billing-secrets）===
BILLING_DATABASE_URL=
# 易支付商户凭据（留空则 billing 不构造 epay 客户端、充值禁用）
EPAY_PID=
EPAY_KEY=
