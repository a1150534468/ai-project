# Host Caddy fragment. The host Caddy terminates HTTPS and forwards all three
# production domains to the internal HTTP-only gateway container.

app.indz.site, admin.indz.site, api.indz.site {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy 127.0.0.1:18080
}
